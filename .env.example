VITE_API_BASE_URL=/api/storefront

# Google Analytics 4 Measurement ID (analytics.google.com > Admin > Data Streams)
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Fase 1.A "Unified Conversion Tracking" - lihat src/lib/analytics.js. Kosongkan kalau
# akun/pixel-nya belum dibuat; pixel/conversion terkait otomatis tidak aktif (lihat index.html),
# jadi aman deploy sebagian dulu sambil akun lain masih dalam proses.

# Google Ads Conversion ID (ads.google.com > Tools > Conversions > pilih conversion action >
# "Tag setup" > "Install the tag yourself" - formatnya AW-XXXXXXXXX). Dipakai lewat gtag.js yang
# sama dengan GA4 di atas.
VITE_GOOGLE_ADS_CONVERSION_ID=

# Conversion label untuk action "Purchase" (bagian setelah "/" di send_to pada snippet Google
# Ads, contoh AW-XXXXXXXXX/AbCdEfGhIj). Tanpa ini, event purchase tetap terkirim ke GA4 tapi
# TIDAK memicu conversion Google Ads.
VITE_GOOGLE_ADS_CONVERSION_LABEL=

# Meta (Facebook/Instagram) Pixel ID (business.facebook.com > Events Manager > Data Sources >
# pixel yang dibuat > pojok kanan atas ada Pixel ID-nya, angka ~15 digit). Satu pixel ini
# otomatis berlaku juga untuk Instagram Ads (linked).
VITE_META_PIXEL_ID=

# TikTok Pixel ID (ads.tiktok.com > Assets > Event > Web Events > pixel yang dibuat, formatnya
# huruf+angka ~20 karakter, contoh CXXXXXXXXXXXXXXXXXXX).
VITE_TIKTOK_PIXEL_ID=

# OAuth Client ID untuk tombol "Masuk dengan Google" (console.cloud.google.com > APIs & Services
# > Credentials). Sama nilainya dengan backend ERP's GOOGLE_CLIENT_ID. Kalau kosong, tombol
# Google tidak dirender (lihat src/components/GoogleLoginButton.jsx).
VITE_GOOGLE_CLIENT_ID=

# Set 'false' untuk menyembunyikan link "Lupa password?" & mematikan halaman /lupa-password -
# dipakai kalau backend's GMAIL_USER/GMAIL_APP_PASSWORD belum dikonfigurasi, biar pelanggan
# tidak ketemu alur reset password yang error. Default aktif (kosong = enabled).
VITE_PASSWORD_RESET_ENABLED=
