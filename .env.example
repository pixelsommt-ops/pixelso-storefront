VITE_API_BASE_URL=/api/storefront

# Google Analytics 4 Measurement ID (analytics.google.com > Admin > Data Streams)
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# OAuth Client ID untuk tombol "Masuk dengan Google" (console.cloud.google.com > APIs & Services
# > Credentials). Sama nilainya dengan backend ERP's GOOGLE_CLIENT_ID. Kalau kosong, tombol
# Google tidak dirender (lihat src/components/GoogleLoginButton.jsx).
VITE_GOOGLE_CLIENT_ID=

# Set 'false' untuk menyembunyikan link "Lupa password?" & mematikan halaman /lupa-password -
# dipakai kalau backend's GMAIL_USER/GMAIL_APP_PASSWORD belum dikonfigurasi, biar pelanggan
# tidak ketemu alur reset password yang error. Default aktif (kosong = enabled).
VITE_PASSWORD_RESET_ENABLED=
